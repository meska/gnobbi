<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- HOME is the files dir on Android: the engine keeps the download under .local/share/gnobbi/**/video-tmp. -->
    <files-path name="received" path=".local/share/gnobbi/" />
    <!-- The staged update APK (`direct` flavor): the app cache is <files>/.cache/gnobbi, the updater uses updates/. -->
    <files-path name="updates" path=".cache/gnobbi/updates/" />
</paths>
