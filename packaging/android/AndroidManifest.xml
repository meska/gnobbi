<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="net.meskatech.gnobbi">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Debug spike: debuggable lets `adb run-as` read the private dir; remove for a release build. -->
    <application android:label="Gnobbi" android:hasCode="false" android:debuggable="true" android:usesCleartextTraffic="false">
        <activity android:name="android.app.NativeActivity" android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|uiMode|density|keyboard|navigation"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="gnobbi" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
